# The published-to-web CSV export URL of the Google Sheet that drives
# the whole app (course/session name, date, code, Google Form URL,
# status). File -> Share -> Publish to web -> select the sheet -> CSV.
# See docs/phase_1_addendum_no_backend.md for the required columns.
VITE_SESSIONS_SHEET_CSV_URL=https://docs.google.com/spreadsheets/d/e/YOUR_PUBLISHED_ID/pub?output=csv

# The published-to-web CSV export URL of a second sheet/tab: each
# lesson's ordered list of question Forms (lesson_number,
# question_number, title, google_form_url). Used by the instructor
# control page. See docs/phase_2_addendum_live_questions.md.
VITE_QUESTIONS_SHEET_CSV_URL=https://docs.google.com/spreadsheets/d/e/YOUR_PUBLISHED_ID/pub?output=csv
